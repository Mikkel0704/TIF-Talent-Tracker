rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A deactivated account (admin, coach, or player - see the "Aktiv træner"
    // checkbox / "Slet"-button's alternative in Admin) keeps existing in Auth and
    // Firestore, but loses all access from here on. Missing "active" field means
    // active (keeps every account created before this feature existed working).
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!("active" in userDoc().data) || userDoc().data.active != false);
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == "admin";
    }

    function isPlayerRole() {
      return isActive() && userDoc().data.role == "player";
    }

    // Et demo-login (users/{uid}.demo == true) er en spiller, der må se alt i sin
    // aargang, men ikke maa sende noget ind: ingen videoer, ingen udfordringer, ingen
    // svar paa udfordringer. Brugt til foraeldremoeder og til familier, der vil se
    // appen an. Klienten viser knapperne og forklarer det - her bliver det haandhaevet.
    // Manglende felt betyder ikke-demo, saa alle eksisterende logins er uaendrede.
    // VIGTIGT: feltet SKAL tjekkes med "in" foerst. Laeser en regel et felt, der ikke
    // findes paa dokumentet, fejler hele udtrykket, og skrivningen bliver naegtet - det
    // spaerrede for uploads fra logins oprettet foer demo-funktionen fandtes.
    function isDemo() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ("demo" in userDoc().data)
        && userDoc().data.demo == true;
    }

    function myPlayerId() {
      return userDoc().data.playerId;
    }

    function allowedYears() {
      return userDoc().data.years;
    }

    function hasYearAccess(year) {
      return isAdmin()
        || (
          isActive()
          && year in allowedYears()
        );
    }

    // A coach/player may additionally be restricted to only "dreng", only "pige",
    // or "begge" (both) within a given year, via users/{uid}.yearGenders: {year: value}.
    // Missing map, or missing entry for this specific year, means unrestricted (both
    // genders) - this keeps every account created before this feature existed working
    // exactly as before, with no migration required for coaches/players who don't need
    // gender-scoping.
    function genderAllowed(year, gender) {
      return isAdmin()
        || !("yearGenders" in userDoc().data)
        || !(year in userDoc().data.yearGenders)
        || userDoc().data.yearGenders[year] == "begge"
        // Et koen, der ikke er sat paa spilleren, kan ikke filtreres paa. Uden det her
        // blev en spiller uden koen helt uskrivbar - ogsaa for sig selv - i stedet for
        // beskyttet, og det var ikke til at gennemskue for nogen. Aargangsadgangen
        // gaelder stadig, saa det er kun koensopdelingen, der ikke kan haandhaeves.
        || gender == null
        || userDoc().data.yearGenders[year] == gender;
    }

    function hasFullAccess(year, gender) {
      return hasYearAccess(year) && genderAllowed(year, gender);
    }

    // HAERDNING: et login uden users-dokument ("fremmed" - alle kan oprette en Auth-konto
    // i projektet) og et deaktiveret login maa INTET, bortset fra at laese sit eget
    // users-dokument. signedIn() alene er derfor aldrig nok til at give adgang; alle
    // regler nedenfor kraever isActive(), enten direkte eller gennem hasFullAccess(),
    // isAdmin() eller isPlayerRole(), som alle kraever et aktivt users-dokument.
    // OBS: !isPlayerRole() er SAND for et deaktiveret login og for en fremmed - det
    // betyder "ikke en aktiv spiller", ikke "traener". Brug det aldrig uden isActive().

    // Traener/admin, der maa skrive det NYE indhold (aargang/koen i skrivningen).
    // .get() og ikke .year: mangler feltet, skal udtrykket ikke fejle - en manglende
    // aargang betyder saa kun admin.
    function traenerTilNyt() {
      return traenerAdgang(request.resource.data.get("year", null), request.resource.data.get("gender", null));
    }

    // Det samme som "isActive() && !isPlayerRole() && hasFullAccess(aargang, koen)", men
    // regnet med ÉT opslag af brugeren i stedet for ti. Hver regel maa hoejst regne 1000
    // udtryk pr. forespoergsel; overskrides det, afvises forespoergslen - ogsaa en, der
    // skulle vaere tilladt. Skrevet med de lange hjaelpere ramte en afvist rettelse af
    // footwork graensen i emulatoren, og saa er der for lidt luft til de tilladte.
    // traenerAdgangAktiv kaldes KUN efter isActive(): den laeser users-dokumentet, og det
    // fejler for et login uden dokument.
    function traenerAdgang(aargang, koen) {
      return isActive() && traenerAdgangAktiv(aargang, koen);
    }
    function traenerAdgangAktiv(aargang, koen) {
      let d = userDoc().data;
      return d.role != "player" && (
        d.role == "admin"
        || (
          aargang in d.years
          && (
            !("yearGenders" in d)
            || !(aargang in d.yearGenders)
            || d.yearGenders[aargang] == "begge"
            || koen == null
            || d.yearGenders[aargang] == koen
          )
        )
      );
    }

    // Traener/admin med adgang til det dokument, der ALLEREDE ligger der. Uden det kunne
    // en traener fra en anden aargang flette sin egen aargang ind paa et barns dokument
    // ({merge:true}) og dermed overtage det. Kun til update og delete: ved en oprettelse
    // er resource null, og saa fejler resource.data - samme faelde som med diff().
    // Gamle dokumenter kan mangle gender (og maaske year), derfor .get().
    function traenerTilEksisterende() {
      return traenerAdgang(resource.data.get("year", null), resource.data.get("gender", null));
    }

    // Sletning. Findes dokumentet ikke, er sletningen en no-op, og saa er der intet at
    // beskytte - admins "Slet alt" sletter blindt alle et barns dokumenter, ogsaa dem,
    // der aldrig blev oprettet, og det skal ikke melde fejl. resource == null tjekkes
    // FOER resource.data, ellers fejler udtrykket.
    function traenerSletter() {
      return isActive() && !isPlayerRole()
        && (resource == null || traenerTilEksisterende());
    }

    // LAESNING OM ANDRE BOERN. En spiller maa kun hente det om de andre, som ranglisten
    // viser: navn, aargang og point (rangliste/ og klubRangliste/, skrevet af serveren).
    // Alt andet - spillerdokumenter, fodteknik, stigen, indsendelser og dueller - laeser en
    // spiller kun for sig selv, og for indsendelser/dueller ogsaa dem i sine egne dueller.
    //
    // Hjaelperne herunder slaar brugeren op ÉN gang (let d) og kaldes KUN efter
    // isActive(), ligesom traenerAdgangAktiv: uden users-dokument fejler opslaget.

    // Spillerens eget id - eller null, hvis loginnet ikke er et spillerlogin med et id.
    // .get(): et traener-/admindokument har intet playerId-felt, og et manglende felt
    // ville vaelte hele udtrykket.
    function egenSpillerId(d) {
      return d.role == "player" && d.get("playerId", null) is string ? d.playerId : null;
    }

    // footwork og juggleLadder: spilleren (ogsaa demo) laeser KUN sit eget dokument, og
    // spillerens gren roerer IKKE resource - appen lytter paa dokumentet, foer barnet har
    // registreret noget, og saa er resource null (samme loesning som logLaeser).
    // Admin roerer heller ikke resource. En traener laeser sin aargang/sit koen (som
    // logLaeser). year med .get(): et dokument uden aargang er kun for admin. gender
    // med vilje UDEN .get(): i en forespoergsel uden koens-klausul giver .get() sin
    // standardvaerdi null, og "koen == null" ville saa lade en drengetraener lytte paa
    // hele aargangen - pigerne med. Det fangede rangliste.rules.test.mjs i emulatoren.
    function egetEllerTraener(playerId) {
      return isActive() && egetEllerTraenerAktiv(playerId);
    }
    function egetEllerTraenerAktiv(playerId) {
      let d = userDoc().data;
      return d.role == "player"
        ? playerId == egenSpillerId(d)
        : (d.role == "admin"
          || (resource != null && traenerAdgangAktiv(resource.data.get("year", null), resource.data.gender)));
    }

    // players/: spilleren (ogsaa demo) laeser KUN sit eget spillerdokument, slaaet op paa
    // id - uden at roere resource. Traener/admin: som foer (aargang og koen).
    function spillerLaeser(playerId) {
      return isActive() && spillerLaeserAktiv(playerId);
    }
    function spillerLaeserAktiv(playerId) {
      let d = userDoc().data;
      return d.role == "player"
        ? playerId == egenSpillerId(d)
        : traenerAdgangAktiv(resource.data.year, resource.data.gender);
    }

    // Indsendelser og dueller: spilleren laeser dem, hvor den selv staar i et af
    // part-felterne. Appen spoerger med ÉN where-klausul pr. felt (playerId, challengerId,
    // opponentId), og reglen kan bevise hver af dem for sig. .get(): en almindelig
    // indsendelse kan mangle duel-felterne, og et manglende felt vaelter udtrykket.
    // egenSpillerId er null for et spillerlogin uden playerId - og null == null maa
    // aldrig give adgang til alle indsendelser uden duel, derfor "!= null" foerst.
    // Traener/admin: som foer (aargang og koen).
    function partLaeser() {
      return isActive() && partLaeserAktiv();
    }
    function partLaeserAktiv() {
      let d = userDoc().data;
      let mig = egenSpillerId(d);
      return d.role == "player"
        ? mig != null && (
            resource.data.get("playerId", null) == mig
            || resource.data.get("challengerId", null) == mig
            || resource.data.get("opponentId", null) == mig
          )
        : traenerAdgangAktiv(resource.data.year, resource.data.gender);
    }

    // rangliste/: én linje pr. barn med navn, aargang og point. Admin alt; alle andre
    // (spiller, demo og traener) linjerne i de aargange, der staar paa deres login - og,
    // hvis loginnet er begraenset til ét koen i aargangen (det er spillerlogins: drenge
    // ser drenge), kun det koens linjer. Saadan har aargangslisten altid vaeret, og et
    // barn skal ikke kunne hente mere, end listen viser. Appen spoerger derfor med
    // where("year","==",aar) OG where("gender","==",koen), naar loginnet er begraenset.
    // gender laeses UDEN standardvaerdi: i en forespoergsel uden koens-klausul kan den
    // saa ikke bevises, og et begraenset login kan ikke lytte paa hele aargangen.
    // .get("years", []): et login uden years-felt faar intet i stedet for en fejl.
    function ranglisteLaeser() {
      return isActive() && ranglisteLaeserAktiv();
    }
    function ranglisteLaeserAktiv() {
      let d = userDoc().data;
      let aar = resource.data.year;
      return d.role == "admin"
        || (aar in d.get("years", [])
            && (!("yearGenders" in d) || !(aar in d.yearGenders) || d.yearGenders[aar] == "begge"
                || d.yearGenders[aar] == resource.data.gender));
    }

    // Talentmaerket kan slaas fra pr. aargang, saa appen kan rulles ud til en aargang,
    // hvor ingen traener koerer medaljeforloebet. Hjemmetraeningen virker uanset hvad.
    //
    // Det haandhaeves HER og ikke kun i brugerfladen. En skjult fane er ingen spaerring:
    // uden det her kunne en video stadig sendes ind i en aargang, der ikke bruger
    // forloebet, og saa ville den ligge og vente paa en traener, der aldrig kigger.
    //
    // Manglende dokument, manglende felt eller manglende aargang betyder SLAAET TIL.
    // Rækkefoelgen er vigtig: laeser en regel et felt, der ikke findes, fejler hele
    // udtrykket og skrivningen bliver naegtet - samme faelde som med "demo" paa
    // brugerdokumentet. Derfor exists() foerst og "in" foer hvert opslag.
    function clubModules() {
      return get(/databases/$(database)/documents/clubConfig/modules).data;
    }
    function talentmaerkeOn(year) {
      return !exists(/databases/$(database)/documents/clubConfig/modules)
        || !("talentmaerke" in clubModules())
        || !(year in clubModules().talentmaerke)
        || clubModules().talentmaerke[year] != false;
    }

    // Users/adgangsstyring
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();

      // Admin maa alt. Derudover maa en bruger rydde sit eget mustChangePassword-flag,
      // og KUN det, naar den midlertidige kode fra traenerens mail er skiftet ud. Uden
      // det ville flaget staa for evigt, for en spiller maa ellers ikke roere users/.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
          && request.resource.data.mustChangePassword == false
        )
        // Samtykke til databehandling. Tidsstemplet SKAL vaere serverens eget
        // (request.time), saa registreringen ikke kan antedateres fra en browser -
        // det er hele pointen med at gemme den.
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["privacyAcceptedAt", "privacyVersion"])
          && request.resource.data.privacyAcceptedAt == request.time
          && request.resource.data.privacyVersion is string
        );
    }

    // Ny struktur: én spiller pr. dokument
    match /players/{playerId} {
      // Spilleren: kun sit eget dokument (se spillerLaeser). Foer laeste ethvert
      // spillerlogin hele aargangens spillerdokumenter - med medaljer, historik og flueben.
      allow read: if spillerLaeser(playerId);

      // Players (role "player") never write player docs directly - passed[]
      // and points are only ever granted by a coach/admin approving a video
      // submission (see submissions/{submissionId} below). This is what
      // stops a player from awarding themselves points via the SDK/console.
      allow create: if isActive()
        && !isPlayerRole()
        && hasFullAccess(request.resource.data.year, request.resource.data.gender);

      allow update: if isActive()
        && !isPlayerRole()
        && hasFullAccess(resource.data.year, resource.data.gender)
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        // Er forloebet slaaet fra, kan der heller ikke saettes flueben eller uddeles
        // medaljer i aargangen - heller ikke af en traener med en gammel fane aaben.
        // "points" staar med vilje IKKE paa listen: en fri duel giver stadig bonuspoint,
        // og den overlever, naar Talentmaerket er fra.
        && (
          talentmaerkeOn(request.resource.data.year)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["passed", "medals"])
        );

      allow delete: if isAdmin();
    }

    // Klubbens modul-indstillinger. Alle aktive logins skal kunne LAESE dem, fordi
    // brugerfladen retter sig efter dem - der staar kun aargangsnumre og til/fra, intet
    // personligt. Kun admin maa skrive.
    // Maanedens spiller: én post pr. maaned og aargang, fx "2026-11_2017". Den regnes ud i
    // en traeners eller admins browser og gemmes én gang - den maa aldrig aendres, saa en
    // kaaring ligger fast, ogsaa hvis der senere rettes i data. Eneste undtagelse: admin
    // maa fjerne en vinder, naar en familie beder om at faa barnet slettet (se update).
    //  - Kun admin eller en traener, der ser HELE aargangen (begge koen), maa oprette den.
    //    En traener, der kun ser drengene, ville ellers kunne kaare uden at se pigerne.
    //  - Ikke foer maaneden er afgjort (den 5. i maaneden efter; her fra den 4. kl. 00 UTC,
    //    fordi dansk midnat er 23 UTC).
    //  - Alle aktive logins maa laese den: den staar paa ranglisten og profilen.
    match /maanedensSpiller/{postId} {
      allow read: if isActive();
      allow create: if isActive() && !isPlayerRole() && nyKaaring(postId);
      // Den eneste rettelse: admin maa FJERNE vindere - naar en familie beder om at faa
      // et barn slettet. Listen skal blive kortere, og intet andet end vindere og
      // tidsstemplet "rettet" maa roeres. Maaned, aargang og beregnet ligger fast.
      // Serveren (sletSpiller) sender update({vindere: <kortere liste>, rettet: serverTimestamp()}).
      allow update: if isAdmin() && kaaringKortere();
      allow delete: if isAdmin();
    }

    // Maanedens topscorer: samme slags post som Maanedens spiller, én pr. maaned og aargang
    // ("2026-11_2017"), med de tal, der afgjorde det (point, oevelser, svaer, mellem, let,
    // starter). Samme regler: alle aktive logins laeser; kun admin eller en traener, der ser
    // HELE aargangen, opretter - én gang, og foerst naar maaneden er afgjort; admin maa kun
    // fjerne vindere (naar et barn slettes). Forskellen: posten kan ikke slettes - heller ikke
    // af admin. En forkert post rettes kun ved at fjerne vindere.
    match /maanedensTopscorer/{postId} {
      allow read: if isActive();
      allow create: if isActive() && !isPlayerRole() && nyKaaring(postId);
      allow update: if isAdmin() && kaaringKortere();
    }

    // Formen paa en ny kaaring (begge priser): kun de fire felter, id = maaned_aargang,
    // hoejst 30 vindere, af en der ser hele aargangen, og kun naar maaneden er afgjort.
    function nyKaaring(postId) {
      return request.resource.data.keys().hasOnly(["maaned", "aargang", "vindere", "beregnet"])
        && request.resource.data.maaned is string
        && request.resource.data.maaned.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.aargang is string
        && postId == request.resource.data.maaned + "_" + request.resource.data.aargang
        && request.resource.data.vindere is list
        && request.resource.data.vindere.size() <= 30
        && heleAargangen(request.resource.data.aargang)
        && maanedErAfgjort(request.resource.data.maaned);
    }

    // Den eneste rettelse af en kaaring: vinderlisten bliver kortere, og kun vindere og
    // tidsstemplet "rettet" roeres.
    function kaaringKortere() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vindere", "rettet"])
        && request.resource.data.vindere is list
        && request.resource.data.vindere.size() < resource.data.vindere.size();
    }

    function heleAargangen(year) {
      return isAdmin() || (
        hasYearAccess(year)
        && (!("yearGenders" in userDoc().data)
            || !(year in userDoc().data.yearGenders)
            || userDoc().data.yearGenders[year] == "begge")
      );
    }

    function maanedErAfgjort(maaned) {
      let aar = int(maaned[0:4]);
      let md = int(maaned[5:7]);
      return request.time >= timestamp.date(md == 12 ? aar + 1 : aar, md == 12 ? 1 : md + 1, 4);
    }

    match /clubConfig/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Gammel v8/v9-struktur - kun til migration
    match /tifTalentTracker/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Spillervideoer til gamification: uploades af spilleren, godkendes/afvises af træner.
    // gender er denormaliseret fra spilleren ved oprettelse, så reglen kan tjekke den
    // uden et ekstra opslag (og så listen kan begrænses korrekt af klienten, se index.html).
    match /submissions/{submissionId} {
      // Spilleren: egne indsendelser og dem i egne dueller (se partLaeser). Foer laeste
      // ethvert spillerlogin hele aargangens indsendelser.
      allow read: if partLaeser();

      allow create: if isPlayerRole()
        && !isDemo()
        && request.resource.data.playerId == myPlayerId()
        && request.resource.data.status == "pending"
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        // Er Talentmaerket slaaet fra paa aargangen, maa der kun sendes video ind til en
        // FRI duel. Den kendes paa, at der ikke hoerer et medaljetrin til: stepIndex er
        // null. En medaljevideo og en oevelsesduel har begge et trin og er dermed
        // spaerret - se option C i aftalen om, hvad der overlever, naar forloebet er fra.
        && (talentmaerkeOn(request.resource.data.year) || request.resource.data.stepIndex == null)
        // Praecis de felter, uploadSubmission() i index.html sender - intet andet. Uden
        // det kunne en spiller laegge vilkaarlige felter paa (fx et selvvalgt videoURL),
        // og hele aargangen kan laese indsendelsen. submittedBy staar med vilje IKKE paa
        // listen: den rummede en foraelders mail.
        // keys() og ikke diff(): paa en oprettelse findes resource ikke.
        && request.resource.data.keys().hasOnly(["playerId", "playerName", "year", "gender", "exercise", "stepIndex", "level", "medal", "status", "challengeId", "challengerId", "opponentId", "submittedAt", "createdAt"]);

      // Only a coach/admin may approve/reject an existing submission. A player may
      // additionally update JUST the view/expiry fields on a challenge submission
      // that belongs to their opponent (not their own), once it has been reviewed -
      // this lets them watch their opponent's video and have it delete itself
      // afterwards (see markSubmissionViewed/deleteViewedSubmissionVideo in index.html).
      allow update: if isActive() && (
        (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender))
        || (
          isPlayerRole()
          && hasFullAccess(resource.data.year, resource.data.gender)
          && resource.data.playerId != myPlayerId()
          && resource.data.status != "pending"
          && (resource.data.challengerId == myPlayerId() || resource.data.opponentId == myPlayerId())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedAt", "videoURL", "videoDeletedAt"])
        )
        // En spiller maa desuden FJERNE sin egen video - aldrig aendre noget andet ved
        // indsendelsen. Det er det, der lader 7-dages-udloebet rydde op i spillerens egen
        // browser, saa en ubehandlet video ikke bliver liggende, fordi ingen traener har
        // aabnet appen i mellemtiden.
        || (
          isPlayerRole()
          && resource.data.playerId == myPlayerId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["videoURL", "videoDeletedAt"])
          && request.resource.data.videoURL == null
        )
      );

      allow delete: if isAdmin();
    }

    // Videolinket og stien til filen. De laa foer paa selve indsendelsen, som hele
    // aargangen maa laese - ranglisten har brug for alles point - og dermed fik ethvert
    // login i aargangen, ogsaa demo-loginnet, links til de andre boerns videoer ned i
    // browseren. Et link virker uden login. Nu ligger link og sti her, og kun tre maa
    // laese dem: traeneren, barnet selv, og duel-modparten naar traeneren har afgjort.
    //
    // Dokumentet har samme id som indsendelsen. "decided" saettes af traeneren ved
    // afgoerelsen; foer det kan modparten ikke hente linket, uanset hvad klienten proever.
    match /submissionVideos/{submissionId} {
      allow read: if isActive() && (
        (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender))
        || (isPlayerRole() && resource.data.playerId == myPlayerId())
        || (
          isPlayerRole()
          && resource.data.decided == true
          && (resource.data.challengerId == myPlayerId() || resource.data.opponentId == myPlayerId())
        )
      );

      // Kun barnet selv opretter, kun for sig selv, og aldrig som allerede afgjort.
      // keys().hasOnly og ikke diff(): paa en oprettelse findes resource ikke.
      allow create: if isPlayerRole()
        && !isDemo()
        && request.resource.data.playerId == myPlayerId()
        && request.resource.data.decided == false
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        && request.resource.data.keys().hasOnly(["playerId","year","gender","videoURL","videoPath","challengeId","challengerId","opponentId","decided","submittedAt","createdAt"]);

      allow update: if isActive() && (
        // Traeneren afgoer (decided) og rydder linket.
        (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender)
          && request.resource.data.year == resource.data.year
          && request.resource.data.playerId == resource.data.playerId)
        // Barnet selv maa kun FJERNE sit link - det er 7-dages-udloebet i egen browser.
        || (
          isPlayerRole()
          && resource.data.playerId == myPlayerId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["videoURL", "videoDeletedAt"])
          && request.resource.data.videoURL == null
        )
        // Modparten maa markere videoen som set og fjerne linket bagefter - intet andet,
        // og foerst naar traeneren har afgjort.
        || (
          isPlayerRole()
          && !isDemo()
          && resource.data.playerId != myPlayerId()
          && resource.data.decided == true
          && (resource.data.challengerId == myPlayerId() || resource.data.opponentId == myPlayerId())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedAt", "videoURL", "videoDeletedAt"])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["videoURL"]) || request.resource.data.videoURL == null)
        )
      );

      allow delete: if isActive() && !isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender);
    }

    // Traenerens note om en spiller. Ligger SEPARAT fra spilleren med vilje: spillere kunne
    // engang laese deres aargangs spillere (nu kun deres eget dokument), og regler kan
    // ikke skjule enkelte felter i et dokument. Laa noten paa spilleren, kunne ethvert
    // spillerlogin laese den. Her har spillere ingen adgang overhovedet.
    // aar og koen er denormaliseret fra spilleren, saa aargangs- og koensadgangen kan
    // tjekkes uden et ekstra opslag - samme moenster som submissions.
    match /playerNotes/{playerId} {
      allow read: if isActive()
        && !isPlayerRole()
        && hasFullAccess(resource.data.year, resource.data.gender);

      // Oprettelse og rettelse staar hver for sig: ved en rettelse skal traeneren ogsaa
      // have adgang til den note, der ligger der i forvejen (se traenerTilEksisterende).
      allow create: if traenerTilNyt();
      allow update: if traenerTilNyt() && traenerTilEksisterende();

      // Foer: signedIn() && !isPlayerRole() - det lod en fremmed og et deaktiveret login
      // slette enhver note.
      allow delete: if traenerSletter();
    }

    // Anmodninger om sletning. Dokument-id ER spillerens id, saa der kun kan ligge én
    // anmodning per barn. En spiller maa oprette og trekke sin EGEN tilbage; kun admin
    // maa se dem alle og behandle dem. Tidsstemplet skal vaere serverens eget, saa en
    // anmodning ikke kan se aeldre ud end den er.
    match /deletionRequests/{playerId} {
      // Admin laeser hele listen. En spiller laeser kun sit eget dokument - og kun ved at
      // slaa det op direkte paa id, ikke ved at liste samlingen.
      allow read: if isAdmin()
        || (isPlayerRole() && playerId == myPlayerId());

      allow create: if isPlayerRole()
        && !isDemo()
        && playerId == myPlayerId()
        && request.resource.data.playerId == playerId
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time;

      // Ingen maa aendre en anmodning efter den er sendt - den kan kun trekkes tilbage.
      allow update: if false;

      allow delete: if isAdmin()
        || (isPlayerRole() && playerId == myPlayerId());
    }

    // JONGLERINGSSTIGEN
    // Fremdrift: KUN tal - hvor langt paa hver stige, og hvilke tricks. Foer kunne hele
    // klubben laese den, fordi klub-top-10 blev regnet i hver browser. Nu regner serveren
    // ranglisten (rangliste/ og klubRangliste/), og en spiller laeser kun sit eget
    // dokument; en traener sin aargang (se egetEllerTraener).
    //
    // Der gemmes ALDRIG point. De regnes ud af tallene her (se index.html), saa en
    // spiller kan ikke skrive sig til point - kun paastaa trin, hvilket er hele
    // tillidsmodellen og det traeneren tager stikproeve paa. Graenserne nedenfor
    // bestemmer det absolutte loft: 16 trin + 12 trin + 16 tricks (JUGGLE_MAIN, JUGGLE_WEAK og JUGGLE_TRICKS i index.html).
    match /juggleLadder/{playerId} {
      allow read: if egetEllerTraener(playerId);

      // Spilleren selv: se stigeSpiller() lige under denne blok.
      allow create: if isActive() && (stigeSpiller(playerId) || traenerTilNyt());
      // Traenere og admin retter frit inden for deres aargang - men kun et dokument, der
      // ALLEREDE ligger i deres aargang/koen, og kun til en aargang/koen, de selv ser.
      allow update: if isActive() && (stigeSpiller(playerId) || (traenerTilNyt() && traenerTilEksisterende()));

      allow delete: if traenerSletter();
    }

    // Spilleren selv paa juggleLadder: kun sit eget dokument, kun fremdriftsfelterne, og
    // kun inden for stigernes laengde. En demo-bruger maa ingenting.
    function stigeSpiller(playerId) {
      return isPlayerRole()
          && !isDemo()
          && playerId == myPlayerId()
          // keys() og ikke diff(resource.data): paa en OPRETTELSE findes resource ikke,
          // og saa fejler hele udtrykket - det ville have afvist hver spillers
          // allerfoerste registrering. keys() virker baade ved oprettelse og rettelse,
          // og er samtidig strammere: dokumentet maa ikke indeholde andre felter.
          // "days" er en ren liste af datoer (ingen navne, ingen uid'er). Den ligger her,
          // fordi en registrering paa stigen ogsaa taeller som aktiv dag i fodteknik-
          // streaken, og den skal kunne regnes ud paa tvaers af aargange.
          && request.resource.data.keys().hasOnly(["mainStep","weakStep","tricks","days","year","gender","updatedAt"])
          //
          // HVERT felt tjekkes med "in" foerst. Klienten sender ét fremdriftsfelt ad
          // gangen - registrerer man et trin paa hovedstigen, staar der KUN mainStep i
          // skrivningen. Ved en oprettelse findes weakStep og tricks derfor ikke, og
          // "request.resource.data.weakStep is int" fejler saa paa et felt, der ikke er
          // der. Et udtryk, der fejler, naegter hele skrivningen. Det spaerrede for hver
          // eneste spillers ALLERFOERSTE registrering, og det blev ikke fanget, fordi
          // testen seedede alle tre felter paa én gang - noget den rigtige klient aldrig
          // goer. Samme faelde som med "demo" paa brugerdokumentet.
          && (!("mainStep" in request.resource.data) || (request.resource.data.mainStep is int && request.resource.data.mainStep >= 0 && request.resource.data.mainStep <= 16))
          && (!("weakStep" in request.resource.data) || (request.resource.data.weakStep is int && request.resource.data.weakStep >= 0 && request.resource.data.weakStep <= 12))
          && (!("tricks" in request.resource.data) || (request.resource.data.tricks is list && request.resource.data.tricks.size() <= 16))
          && (!("days" in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 400))
          // Spilleren skal skrive SIN egen aargang - samme krav som i juggleLog. Uden det
          // kunne et barn parkere sin stige i en aargang, det ikke hoerer til.
          && hasFullAccess(request.resource.data.year, request.resource.data.gender);
    }

    // Loggen - hvem registrerede hvad hvornaar. Her staar der bruger-id'er, saa den er
    // aargangsbegraenset som alt andet og laeses IKKE paa tvaers af klubben.
    match /juggleLog/{playerId} {
      allow read: if logLaeser(playerId);

      allow create: if isActive() && (logSpiller(playerId) || traenerTilNyt());
      allow update: if isActive() && (logSpiller(playerId) || (traenerTilNyt() && traenerTilEksisterende()));

      allow delete: if traenerSletter();
    }

    // Hvem maa laese en log (juggleLog og footworkLog). Der staar bruger-id'er, traenermails
    // og - i footworkLog - familiens fritekst-begrundelse for en joker. Derfor:
    //  - traener/admin: som foer, hele aargangen/koennet.
    //  - spiller (ogsaa demo): KUN sit eget dokument. Foer kunne ethvert spillerlogin i
    //    aargangen laese de andre boerns begrundelser.
    // Spillerens gren roerer IKKE resource: klienten lytter paa sit eget dokument, og det
    // findes ikke, foer barnet har registreret noget. Saa er resource null, og et opslag i
    // resource.data ville fejle og vaelte lytteren. Stien (playerId) er nok.
    // En spiller kan dermed heller ikke liste samlingen: en forespoergsel paa year kan
    // ikke bevise, at hvert dokument er barnets eget.
    function logLaeser(playerId) {
      return isActive() && (
        (isPlayerRole() && playerId == myPlayerId())
        || (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender))
      );
    }

    // Spilleren skriver sin egen log (ikke demo), i sin egen aargang. Uaendret fra foer.
    function logSpiller(playerId) {
      return isPlayerRole() && !isDemo() && playerId == myPlayerId()
        && hasFullAccess(request.resource.data.year, request.resource.data.gender);
    }

    // Daglig fodteknik. Samme todeling som stigen: en spiller laeser kun sit eget dokument,
    // en traener sin aargang (se egetEllerTraener). Dagene viser, hvornaar et barn har
    // traenet - det er ikke noget, de andre boern skal kunne hente.
    //
    // Det vigtige her er opdelingen af joker-felterne. Reglerne kan ikke se ned i et kort
    // og tjekke, at jokers["2026-11-05"] ikke er sat til "approved" - men de kan se,
    // hvilke FELTER en skrivning roerer. Derfor anmoder familien i "jokerRequests", og
    // traeneren afgoer i "jokers": et spillerlogin kan altsaa ikke godkende sin egen joker
    // og dermed holde en streak kunstigt i live.
    match /footwork/{playerId} {
      allow read: if egetEllerTraener(playerId);

      // Oprettelse og rettelse staar hver for sig med vilje. Paa en OPRETTELSE findes
      // resource ikke, saa diff(resource.data) ville fejle og afvise hver spillers
      // allerfoerste registrering - samme faelde som i juggleLadder. Ved en RETTELSE
      // skal vi derimod bruge diff: {merge:true} sender hele det resulterende dokument,
      // saa keys() ville ogsaa indeholde "jokers", hvis traeneren allerede har afgjort en.
      allow create: if isActive() && (
        (
          isPlayerRole()
          && !isDemo()
          && playerId == myPlayerId()
          && request.resource.data.keys().hasOnly(["days","jokerRequests","year","gender","updatedAt"])
          && (!("days" in request.resource.data) || (request.resource.data.days is map && request.resource.data.days.size() <= 1500))
          && (!("jokerRequests" in request.resource.data) || (request.resource.data.jokerRequests is map && request.resource.data.jokerRequests.size() <= 1500))
          // Spilleren skal skrive SIN egen aargang. Uden det kunne et barn parkere sit
          // dokument i en aargang, det ikke hoerer til - og dermed i en traener, der
          // ikke kan rette det.
          && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        )
        || traenerTilNyt()
      );

      // Traeneren: baade det eksisterende dokument og det nye skal ligge i traenerens
      // aargang/koen - ellers kunne en anden aargangs traener flette sin aargang ind.
      allow update: if isActive() && (
        (
          isPlayerRole()
          && !isDemo()
          && playerId == myPlayerId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["days","jokerRequests","year","gender","updatedAt"])
          && (!("days" in request.resource.data) || (request.resource.data.days is map && request.resource.data.days.size() <= 1500))
          && (!("jokerRequests" in request.resource.data) || (request.resource.data.jokerRequests is map && request.resource.data.jokerRequests.size() <= 1500))
          && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        )
        || (traenerTilNyt() && traenerTilEksisterende())
      );

      allow delete: if traenerSletter();
    }

    // Loggen og joker-begrundelserne. Her staar fritekst og bruger-id'er, saa den er
    // aargangsbegraenset og laeses IKKE paa tvaers af klubben - og en spiller laeser kun
    // sin egen (se logLaeser under juggleLog).
    match /footworkLog/{playerId} {
      allow read: if logLaeser(playerId);

      allow create: if isActive() && (logSpiller(playerId) || traenerTilNyt());
      allow update: if isActive() && (logSpiller(playerId) || (traenerTilNyt() && traenerTilEksisterende()));

      allow delete: if traenerSletter();
    }

    // Klub-rangliste (gammel spejl-tabel): KUN navn, aargang og point. Spillerne laeser
    // nu top-10 fra klubRangliste/top, som serveren skriver, saa her maa kun admin og en
    // traener i dokumentets aargang laese (samme aargangsgraense som skrivningen).
    // Skrives kun af traenere/admin (se syncClubRanking i index.html); en spiller kan
    // altsaa ikke skrive sig selv oeverst.
    // Der er intet koen paa dokumentet, saa det er aargangen, der afgoer. Foer kunne
    // enhver aktiv traener skrive et vilkaarligt barns point (fx 9999) i en anden aargang.
    // .get(): et dokument uden year kan kun admin roere.
    match /clubRanking/{playerId} {
      allow read: if isAdmin()
        || (isActive() && !isPlayerRole() && resource != null
            && hasYearAccess(resource.data.get("year", null)));
      allow create: if isActive() && !isPlayerRole()
        && hasYearAccess(request.resource.data.get("year", null));
      allow update: if isActive() && !isPlayerRole()
        && hasYearAccess(resource.data.get("year", null))
        && hasYearAccess(request.resource.data.get("year", null));
      // Findes dokumentet ikke, er sletningen en no-op (admins "Slet alt" sletter blindt).
      allow delete: if isActive() && !isPlayerRole()
        && (resource == null || hasYearAccess(resource.data.get("year", null)));
    }

    // Serverens rangliste (Cloud Function med Admin SDK, som gaar uden om reglerne).
    // Ingen klient maa skrive - heller ikke admin - ellers kunne et barn faa point, der
    // ikke kan regnes ud af data. Laesning: se ranglisteLaeser.
    match /rangliste/{playerId} {
      allow read: if ranglisteLaeser();
      allow write: if false;
    }

    // Klubbens top-10 paa tvaers af aargange (klubRangliste/top), ogsaa skrevet af
    // serveren. Kun navn, aargang og total - alle aktive logins maa laese den.
    match /klubRangliste/{docId} {
      allow read: if isActive();
      allow write: if false;
    }

    // Spiller-mod-spiller udfordringer. gender er den udfordrende spillers køn,
    // denormaliseret ligesom på submissions.
    match /challenges/{challengeId} {
      // Spilleren: kun dueller, den selv er part i (se partLaeser).
      allow read: if partLaeser();

      allow create: if isPlayerRole()
        && !isDemo()
        && request.resource.data.challengerId == myPlayerId()
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        // Med Talentmaerket slaaet fra findes oevelserne og trinnene ikke for aargangen,
        // saa kun den frie duel ("flest jongleringer", "fedeste trick") kan oprettes.
        // Mangler "type" helt, er udtrykket falsk, og saa kraeves forloebet slaaet til -
        // det sikre svar, hvis dokumentet ser anderledes ud end forventet.
        && (talentmaerkeOn(request.resource.data.year) || request.resource.data.type == "freestyle");

      allow update: if isActive() && (
        (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender))
        || (
          isPlayerRole()
          && !isDemo()
          && resource.data.opponentId == myPlayerId()
          && resource.data.status == "pending"
          && request.resource.data.status in ["active", "declined"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
        )
      );

      allow delete: if isAdmin();
    }
  }
}
