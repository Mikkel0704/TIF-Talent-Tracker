rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A deactivated account (admin, coach, or player - see the "Aktiv træner"
    // checkbox / "Slet"-button's alternative in Admin) keeps existing in Auth and
    // Firestore, but loses all access from here on. Missing "active" field means
    // active (keeps every account created before this feature existed working).
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!("active" in userDoc().data) || userDoc().data.active != false);
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == "admin";
    }

    function isPlayerRole() {
      return isActive() && userDoc().data.role == "player";
    }

    // Et demo-login (users/{uid}.demo == true) er en spiller, der må se alt i sin
    // aargang, men ikke maa sende noget ind: ingen videoer, ingen udfordringer, ingen
    // svar paa udfordringer. Brugt til foraeldremoeder og til familier, der vil se
    // appen an. Klienten viser knapperne og forklarer det - her bliver det haandhaevet.
    // Manglende felt betyder ikke-demo, saa alle eksisterende logins er uaendrede.
    // VIGTIGT: feltet SKAL tjekkes med "in" foerst. Laeser en regel et felt, der ikke
    // findes paa dokumentet, fejler hele udtrykket, og skrivningen bliver naegtet - det
    // spaerrede for uploads fra logins oprettet foer demo-funktionen fandtes.
    function isDemo() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && ("demo" in userDoc().data)
        && userDoc().data.demo == true;
    }

    function myPlayerId() {
      return userDoc().data.playerId;
    }

    function allowedYears() {
      return userDoc().data.years;
    }

    function hasYearAccess(year) {
      return isAdmin()
        || (
          isActive()
          && year in allowedYears()
        );
    }

    // A coach/player may additionally be restricted to only "dreng", only "pige",
    // or "begge" (both) within a given year, via users/{uid}.yearGenders: {year: value}.
    // Missing map, or missing entry for this specific year, means unrestricted (both
    // genders) - this keeps every account created before this feature existed working
    // exactly as before, with no migration required for coaches/players who don't need
    // gender-scoping.
    function genderAllowed(year, gender) {
      return isAdmin()
        || !("yearGenders" in userDoc().data)
        || !(year in userDoc().data.yearGenders)
        || userDoc().data.yearGenders[year] == "begge"
        || userDoc().data.yearGenders[year] == gender;
    }

    function hasFullAccess(year, gender) {
      return hasYearAccess(year) && genderAllowed(year, gender);
    }

    // Talentmaerket kan slaas fra pr. aargang, saa appen kan rulles ud til en aargang,
    // hvor ingen traener koerer medaljeforloebet. Hjemmetraeningen virker uanset hvad.
    //
    // Det haandhaeves HER og ikke kun i brugerfladen. En skjult fane er ingen spaerring:
    // uden det her kunne en video stadig sendes ind i en aargang, der ikke bruger
    // forloebet, og saa ville den ligge og vente paa en traener, der aldrig kigger.
    //
    // Manglende dokument, manglende felt eller manglende aargang betyder SLAAET TIL.
    // Rækkefoelgen er vigtig: laeser en regel et felt, der ikke findes, fejler hele
    // udtrykket og skrivningen bliver naegtet - samme faelde som med "demo" paa
    // brugerdokumentet. Derfor exists() foerst og "in" foer hvert opslag.
    function clubModules() {
      return get(/databases/$(database)/documents/clubConfig/modules).data;
    }
    function talentmaerkeOn(year) {
      return !exists(/databases/$(database)/documents/clubConfig/modules)
        || !("talentmaerke" in clubModules())
        || !(year in clubModules().talentmaerke)
        || clubModules().talentmaerke[year] != false;
    }

    // Users/adgangsstyring
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, delete: if isAdmin();

      // Admin maa alt. Derudover maa en bruger rydde sit eget mustChangePassword-flag,
      // og KUN det, naar den midlertidige kode fra traenerens mail er skiftet ud. Uden
      // det ville flaget staa for evigt, for en spiller maa ellers ikke roere users/.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
          && request.resource.data.mustChangePassword == false
        )
        // Samtykke til databehandling. Tidsstemplet SKAL vaere serverens eget
        // (request.time), saa registreringen ikke kan antedateres fra en browser -
        // det er hele pointen med at gemme den.
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["privacyAcceptedAt", "privacyVersion"])
          && request.resource.data.privacyAcceptedAt == request.time
          && request.resource.data.privacyVersion is string
        );
    }

    // Ny struktur: én spiller pr. dokument
    match /players/{playerId} {
      allow read: if signedIn() && hasFullAccess(resource.data.year, resource.data.gender);

      // Players (role "player") never write player docs directly - passed[]
      // and points are only ever granted by a coach/admin approving a video
      // submission (see submissions/{submissionId} below). This is what
      // stops a player from awarding themselves points via the SDK/console.
      allow create: if signedIn()
        && !isPlayerRole()
        && hasFullAccess(request.resource.data.year, request.resource.data.gender);

      allow update: if signedIn()
        && !isPlayerRole()
        && hasFullAccess(resource.data.year, resource.data.gender)
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        // Er forloebet slaaet fra, kan der heller ikke saettes flueben eller uddeles
        // medaljer i aargangen - heller ikke af en traener med en gammel fane aaben.
        // "points" staar med vilje IKKE paa listen: en fri duel giver stadig bonuspoint,
        // og den overlever, naar Talentmaerket er fra.
        && (
          talentmaerkeOn(request.resource.data.year)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["passed", "medals"])
        );

      allow delete: if isAdmin();
    }

    // Klubbens modul-indstillinger. Alle aktive logins skal kunne LAESE dem, fordi
    // brugerfladen retter sig efter dem - der staar kun aargangsnumre og til/fra, intet
    // personligt. Kun admin maa skrive.
    match /clubConfig/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Gammel v8/v9-struktur - kun til migration
    match /tifTalentTracker/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Spillervideoer til gamification: uploades af spilleren, godkendes/afvises af træner.
    // gender er denormaliseret fra spilleren ved oprettelse, så reglen kan tjekke den
    // uden et ekstra opslag (og så listen kan begrænses korrekt af klienten, se index.html).
    match /submissions/{submissionId} {
      allow read: if signedIn() && hasFullAccess(resource.data.year, resource.data.gender);

      allow create: if isPlayerRole()
        && !isDemo()
        && request.resource.data.playerId == myPlayerId()
        && request.resource.data.status == "pending"
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        // Er Talentmaerket slaaet fra paa aargangen, maa der kun sendes video ind til en
        // FRI duel. Den kendes paa, at der ikke hoerer et medaljetrin til: stepIndex er
        // null. En medaljevideo og en oevelsesduel har begge et trin og er dermed
        // spaerret - se option C i aftalen om, hvad der overlever, naar forloebet er fra.
        && (talentmaerkeOn(request.resource.data.year) || request.resource.data.stepIndex == null);

      // Only a coach/admin may approve/reject an existing submission. A player may
      // additionally update JUST the view/expiry fields on a challenge submission
      // that belongs to their opponent (not their own), once it has been reviewed -
      // this lets them watch their opponent's video and have it delete itself
      // afterwards (see markSubmissionViewed/deleteViewedSubmissionVideo in index.html).
      allow update: if signedIn() && (
        (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender))
        || (
          isPlayerRole()
          && hasFullAccess(resource.data.year, resource.data.gender)
          && resource.data.playerId != myPlayerId()
          && resource.data.status != "pending"
          && (resource.data.challengerId == myPlayerId() || resource.data.opponentId == myPlayerId())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedAt", "videoURL", "videoDeletedAt"])
        )
        // En spiller maa desuden FJERNE sin egen video - aldrig aendre noget andet ved
        // indsendelsen. Det er det, der lader 7-dages-udloebet rydde op i spillerens egen
        // browser, saa en ubehandlet video ikke bliver liggende, fordi ingen traener har
        // aabnet appen i mellemtiden.
        || (
          isPlayerRole()
          && resource.data.playerId == myPlayerId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["videoURL", "videoDeletedAt"])
          && request.resource.data.videoURL == null
        )
      );

      allow delete: if isAdmin();
    }

    // Traenerens note om en spiller. Ligger SEPARAT fra spilleren med vilje: spillere skal
    // kunne laese deres aargangs spillere (navne og point til ranglisten), og regler kan
    // ikke skjule enkelte felter i et dokument. Laa noten paa spilleren, kunne ethvert
    // spillerlogin laese den. Her har spillere ingen adgang overhovedet.
    // aar og koen er denormaliseret fra spilleren, saa aargangs- og koensadgangen kan
    // tjekkes uden et ekstra opslag - samme moenster som submissions.
    match /playerNotes/{playerId} {
      allow read: if signedIn()
        && !isPlayerRole()
        && hasFullAccess(resource.data.year, resource.data.gender);

      allow create, update: if signedIn()
        && !isPlayerRole()
        && hasFullAccess(request.resource.data.year, request.resource.data.gender);

      allow delete: if signedIn() && !isPlayerRole();
    }

    // Anmodninger om sletning. Dokument-id ER spillerens id, saa der kun kan ligge én
    // anmodning per barn. En spiller maa oprette og trekke sin EGEN tilbage; kun admin
    // maa se dem alle og behandle dem. Tidsstemplet skal vaere serverens eget, saa en
    // anmodning ikke kan se aeldre ud end den er.
    match /deletionRequests/{playerId} {
      // Admin laeser hele listen. En spiller laeser kun sit eget dokument - og kun ved at
      // slaa det op direkte paa id, ikke ved at liste samlingen.
      allow read: if isAdmin()
        || (isPlayerRole() && playerId == myPlayerId());

      allow create: if isPlayerRole()
        && !isDemo()
        && playerId == myPlayerId()
        && request.resource.data.playerId == playerId
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time;

      // Ingen maa aendre en anmodning efter den er sendt - den kan kun trekkes tilbage.
      allow update: if false;

      allow delete: if isAdmin()
        || (isPlayerRole() && playerId == myPlayerId());
    }

    // JONGLERINGSSTIGEN
    // Fremdrift: KUN tal - hvor langt paa hver stige, og hvilke tricks. Ingen navne,
    // ingen bruger-id'er. Derfor maa alle aktive logins laese den: klub-top-10 gaar paa
    // tvaers af aargange og skal kunne laegge stigens point til.
    //
    // Der gemmes ALDRIG point. De regnes ud af tallene her (se index.html), saa en
    // spiller kan ikke skrive sig til point - kun paastaa trin, hvilket er hele
    // tillidsmodellen og det traeneren tager stikproeve paa. Graenserne nedenfor
    // bestemmer det absolutte loft: 15 trin + 10 trin + 6 tricks.
    match /juggleLadder/{playerId} {
      allow read: if isActive();

      // Spilleren selv: kun sit eget dokument, kun fremdriftsfelterne, og kun inden
      // for stigernes laengde. En demo-bruger maa ingenting.
      allow create, update: if isActive() && (
        (
          isPlayerRole()
          && !isDemo()
          && playerId == myPlayerId()
          // keys() og ikke diff(resource.data): paa en OPRETTELSE findes resource ikke,
          // og saa fejler hele udtrykket - det ville have afvist hver spillers
          // allerfoerste registrering. keys() virker baade ved oprettelse og rettelse,
          // og er samtidig strammere: dokumentet maa ikke indeholde andre felter.
          // "days" er en ren liste af datoer (ingen navne, ingen uid'er). Den ligger her,
          // fordi en registrering paa stigen ogsaa taeller som aktiv dag i fodteknik-
          // streaken, og den skal kunne regnes ud paa tvaers af aargange.
          && request.resource.data.keys().hasOnly(["mainStep","weakStep","tricks","days","year","gender","updatedAt"])
          && (!("days" in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 400))
          && request.resource.data.mainStep is int
          && request.resource.data.mainStep >= 0
          && request.resource.data.mainStep <= 15
          && request.resource.data.weakStep is int
          && request.resource.data.weakStep >= 0
          && request.resource.data.weakStep <= 10
          && request.resource.data.tricks is list
          && request.resource.data.tricks.size() <= 6
          // Spilleren skal skrive SIN egen aargang - samme krav som i juggleLog. Uden det
          // kunne et barn parkere sin stige i en aargang, det ikke hoerer til.
          && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        )
        // Traenere og admin retter frit inden for deres aargang.
        || (!isPlayerRole() && hasFullAccess(request.resource.data.year, request.resource.data.gender))
      );

      allow delete: if isActive() && !isPlayerRole();
    }

    // Loggen - hvem registrerede hvad hvornaar. Her staar der bruger-id'er, saa den er
    // aargangsbegraenset som alt andet og laeses IKKE paa tvaers af klubben.
    match /juggleLog/{playerId} {
      allow read: if isActive() && hasFullAccess(resource.data.year, resource.data.gender);

      allow create, update: if isActive() && (
        (isPlayerRole() && !isDemo() && playerId == myPlayerId())
        || !isPlayerRole()
      ) && hasFullAccess(request.resource.data.year, request.resource.data.gender);

      allow delete: if isActive() && !isPlayerRole();
    }

    // Daglig fodteknik. Samme todeling som stigen: tallene her laeses klub-bredt, fordi
    // klub-top-10 gaar paa tvaers af aargange og skal vise SAMME total som aargangs-
    // listen. Dokumentet rummer kun datoer, antal og joker-status - intet navn, intet uid.
    //
    // Det vigtige her er opdelingen af joker-felterne. Reglerne kan ikke se ned i et kort
    // og tjekke, at jokers["2026-11-05"] ikke er sat til "approved" - men de kan se,
    // hvilke FELTER en skrivning roerer. Derfor anmoder familien i "jokerRequests", og
    // traeneren afgoer i "jokers": et spillerlogin kan altsaa ikke godkende sin egen joker
    // og dermed holde en streak kunstigt i live.
    match /footwork/{playerId} {
      allow read: if isActive();

      // Oprettelse og rettelse staar hver for sig med vilje. Paa en OPRETTELSE findes
      // resource ikke, saa diff(resource.data) ville fejle og afvise hver spillers
      // allerfoerste registrering - samme faelde som i juggleLadder. Ved en RETTELSE
      // skal vi derimod bruge diff: {merge:true} sender hele det resulterende dokument,
      // saa keys() ville ogsaa indeholde "jokers", hvis traeneren allerede har afgjort en.
      allow create: if isActive() && (
        (
          isPlayerRole()
          && !isDemo()
          && playerId == myPlayerId()
          && request.resource.data.keys().hasOnly(["days","jokerRequests","year","gender","updatedAt"])
          && (!("days" in request.resource.data) || (request.resource.data.days is map && request.resource.data.days.size() <= 1500))
          && (!("jokerRequests" in request.resource.data) || (request.resource.data.jokerRequests is map && request.resource.data.jokerRequests.size() <= 1500))
          // Spilleren skal skrive SIN egen aargang. Uden det kunne et barn parkere sit
          // dokument i en aargang, det ikke hoerer til - og dermed i en traener, der
          // ikke kan rette det.
          && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        )
        || (!isPlayerRole() && hasFullAccess(request.resource.data.year, request.resource.data.gender))
      );

      allow update: if isActive() && (
        (
          isPlayerRole()
          && !isDemo()
          && playerId == myPlayerId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["days","jokerRequests","year","gender","updatedAt"])
          && (!("days" in request.resource.data) || (request.resource.data.days is map && request.resource.data.days.size() <= 1500))
          && (!("jokerRequests" in request.resource.data) || (request.resource.data.jokerRequests is map && request.resource.data.jokerRequests.size() <= 1500))
          && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        )
        || (!isPlayerRole() && hasFullAccess(request.resource.data.year, request.resource.data.gender))
      );

      allow delete: if isActive() && !isPlayerRole();
    }

    // Loggen og joker-begrundelserne. Her staar fritekst og bruger-id'er, saa den er
    // aargangsbegraenset og laeses IKKE paa tvaers af klubben.
    match /footworkLog/{playerId} {
      allow read: if isActive() && hasFullAccess(resource.data.year, resource.data.gender);

      allow create, update: if isActive() && (
        (isPlayerRole() && !isDemo() && playerId == myPlayerId())
        || !isPlayerRole()
      ) && hasFullAccess(request.resource.data.year, request.resource.data.gender);

      allow delete: if isActive() && !isPlayerRole();
    }

    // Klub-rangliste: en spejl-tabel med KUN navn, aargang og point, saa spillerne kan se
    // en top-10 paa tvaers af hele klubben. players/ kan ikke bruges til det, fordi en
    // spiller kun maa laese sin egen aargang - og den begraensning skal blive staaende,
    // fordi players/ ogsaa rummer noter og historik. Her staar der intet foelsomt.
    // Skrives kun af traenere/admin (se syncClubRanking i index.html); en spiller kan
    // altsaa ikke skrive sig selv oeverst.
    match /clubRanking/{playerId} {
      allow read: if isActive();
      allow write: if isActive() && !isPlayerRole();
    }

    // Spiller-mod-spiller udfordringer. gender er den udfordrende spillers køn,
    // denormaliseret ligesom på submissions.
    match /challenges/{challengeId} {
      allow read: if signedIn() && hasFullAccess(resource.data.year, resource.data.gender);

      allow create: if isPlayerRole()
        && !isDemo()
        && request.resource.data.challengerId == myPlayerId()
        && hasFullAccess(request.resource.data.year, request.resource.data.gender)
        // Med Talentmaerket slaaet fra findes oevelserne og trinnene ikke for aargangen,
        // saa kun den frie duel ("flest jongleringer", "fedeste trick") kan oprettes.
        // Mangler "type" helt, er udtrykket falsk, og saa kraeves forloebet slaaet til -
        // det sikre svar, hvis dokumentet ser anderledes ud end forventet.
        && (talentmaerkeOn(request.resource.data.year) || request.resource.data.type == "freestyle");

      allow update: if signedIn() && (
        (!isPlayerRole() && hasFullAccess(resource.data.year, resource.data.gender))
        || (
          isPlayerRole()
          && !isDemo()
          && resource.data.opponentId == myPlayerId()
          && resource.data.status == "pending"
          && request.resource.data.status in ["active", "declined"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
        )
      );

      allow delete: if isAdmin();
    }
  }
}
