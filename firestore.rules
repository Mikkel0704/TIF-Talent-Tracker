rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == "admin";
    }

    function isPlayerRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == "player";
    }

    function myPlayerId() {
      return userDoc().data.playerId;
    }

    function allowedYears() {
      return userDoc().data.years;
    }

    function hasYearAccess(year) {
      return isAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && year in allowedYears()
        );
    }

    // Users/adgangsstyring
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Ny struktur: én spiller pr. dokument
    match /players/{playerId} {
      allow read: if signedIn() && hasYearAccess(resource.data.year);

      // Players (role "player") never write player docs directly - passed[]
      // and points are only ever granted by a coach/admin approving a video
      // submission (see submissions/{submissionId} below). This is what
      // stops a player from awarding themselves points via the SDK/console.
      allow create: if signedIn()
        && !isPlayerRole()
        && hasYearAccess(request.resource.data.year);

      allow update: if signedIn()
        && !isPlayerRole()
        && hasYearAccess(resource.data.year)
        && hasYearAccess(request.resource.data.year);

      allow delete: if isAdmin();
    }

    // Gammel v8/v9-struktur - kun til migration
    match /tifTalentTracker/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Spillervideoer til gamification: uploades af spilleren, godkendes/afvises af træner.
    match /submissions/{submissionId} {
      allow read: if signedIn() && hasYearAccess(resource.data.year);

      allow create: if isPlayerRole()
        && request.resource.data.playerId == myPlayerId()
        && request.resource.data.status == "pending"
        && hasYearAccess(request.resource.data.year);

      // Only a coach/admin may approve/reject an existing submission.
      allow update: if signedIn() && !isPlayerRole() && hasYearAccess(resource.data.year);

      allow delete: if isAdmin();
    }

    // Spiller-mod-spiller udfordringer.
    match /challenges/{challengeId} {
      allow read: if signedIn() && hasYearAccess(resource.data.year);

      allow create: if isPlayerRole()
        && request.resource.data.challengerId == myPlayerId()
        && hasYearAccess(request.resource.data.year);

      allow update: if signedIn() && (
        (!isPlayerRole() && hasYearAccess(resource.data.year))
        || (
          isPlayerRole()
          && resource.data.opponentId == myPlayerId()
          && resource.data.status == "pending"
          && request.resource.data.status in ["active", "declined"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
        )
      );

      allow delete: if isAdmin();
    }
  }
}
