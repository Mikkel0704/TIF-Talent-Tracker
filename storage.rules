// Lagerregler for TIF Talent Tracker. Filen rulles ud for sig - se README.
//
// Indsendte videoer ligger under submissions/{login-id}/{tidsstempel}_{filnavn}.
// Klubbens instruktionsvideoer ligger under guides/ - se nederst.
//
// Tre ting er lukket her, som stod aabne foer:
//  1. Ingen kan LISTE en mappe. Foer kunne ethvert login - ogsaa demo-loginnet - liste et
//     barns mappe og hente videoerne, fordi mappen hed det samme som spillerens id, og
//     det id staar paa klub-ranglisten.
//  2. Man kan kun uploade til SIN EGEN mappe. Mappen hedder nu loginnets id, som reglerne
//     kan sammenligne med request.auth.uid. Spiller-id'et kunne de ikke kontrollere.
//  3. Kun ejeren kan hente filen direkte. Traeneren og duel-modparten ser videoen gennem
//     det link, der ligger beskyttet i Firestore (submissionVideos), ikke gennem lageret.
//
// Reglerne her kan ikke slaa roller op i Firestore: opslaget paa tvaers af tjenesterne
// har vist sig at fejle paa dette projekt. Derfor er sletning tilladt for ethvert login,
// MEN kun med den praecise sti - og stien staar nu kun i submissionVideos, som kun
// traeneren, barnet selv og duel-modparten efter afgoerelsen kan laese. Det er de samme
// tre, appen i forvejen lader slette. Vaerste tilfaelde er, at en af dem sletter en video
// for tidligt; ingen point og ingen data haenger paa filen.
//
// Boetten har desuden sin egen slettefrist (lifecycle), saa en fil, appen aldrig faar
// ryddet op, forsvinder af sig selv efter 8 dage.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{mappe}/{fileName} {
      allow get: if request.auth != null && request.auth.uid == mappe;
      allow list: if false;

      // "resource == null": stien maa ikke findes i forvejen. Uden det gik en overskrivning
      // af en eksisterende fil igennem som en oprettelse i emulatoren, selv om opdatering
      // er forbudt nedenfor - saa forbuddet staar begge steder. Appen rammer den aldrig,
      // fordi hver sti indeholder et tidsstempel.
      allow create: if request.auth != null
        && request.auth.uid == mappe
        && resource == null
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      // En fil kan ikke skiftes ud, kun slettes og uploades igen.
      allow update: if false;

      allow delete: if request.auth != null;
    }

    // Instruktionsvideoer: guides/{plads}/{tidsstempel}_{filnavn}. Dem laegger kun en
    // administrator op, og de bliver liggende - boettens slettefrist gaelder kun
    // submissions/.
    //
    // Rollen staar i Firestore, og den kan reglerne her ikke slaa op (se oeverst). I
    // stedet baerer administratorens login et maerke, "admin", som saettes uden for
    // appen med tests/vaerktoej/saet-admin-maerke.cjs. Maerket kan ikke saettes fra en
    // browser. Det styrer kun, hvem der kan laegge filer i mappen og slette dem igen:
    // hvilken video appen VISER, staar i clubConfig/guideVideos, som kun en administrator
    // kan skrive, og dér foelger adgangen rollen i appen fra det ene oejeblik til det naeste.
    //
    // Spillere og traenere ser videoen gennem adressen i det dokument, ikke gennem
    // lageret - derfor maa heller ingen andre end administratoren hente filen direkte.
    match /guides/{plads}/{fileName} {
      allow get: if erAdmin();
      allow list: if false;
      allow create: if erAdmin()
        && resource == null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow update: if false;
      allow delete: if erAdmin();
    }

    // "in": et login uden maerket har slet ikke feltet, og at laese et felt, der ikke
    // findes, er en fejl - som ganske vist ogsaa ender med et nej, men det skal staa der
    // med vilje og ikke ved et tilfaelde.
    function erAdmin() {
      return request.auth != null
        && "admin" in request.auth.token
        && request.auth.token.admin == true;
    }
  }
}
