// Firebase Storage security rules for TIF Talent Tracker's player training-video
// uploads. This file IS deployed (see README for how); it is not just a reference.
//
// Videos are uploaded by a player to: submissions/{playerId}/{timestamp}_{filename}
// and deleted automatically by the app once a coach/admin has approved or rejected
// the matching submission (see reviewSubmission() in index.html) - only the points/
// pass-status persist after that, not the raw footage.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{playerId}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      // Ideally this would check the requester's role like firestore.rules does
      // (coach/admin only, matching who may approve/reject a submission), via
      // firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).
      // That cross-service call reliably returns storage/unauthorized on this
      // project even for a bare existence check, independent of rule content -
      // confirmed by testing progressively simpler rules, not a syntax issue.
      // Not worth chasing a Google-side IAM/linkage quirk for this: deletion is
      // only ever triggered by reviewSubmission() in index.html, which is itself
      // gated to coach/admin by firestore.rules (a player's Firestore write to
      // approve/reject their own submission is already rejected there). Worst
      // case if a player calls this directly from the browser console is they
      // delete an unreviewed video (their own workflow, not anyone's data/points).
      allow delete: if request.auth != null;
    }
  }
}
